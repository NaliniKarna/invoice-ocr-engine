# Copy to .env (never commit .env). In production use a secret manager, not a file.
OCR_ENV=dev
OCR_DATABASE_URL=postgresql+psycopg://ocr:ocr@postgres:5432/ocr
OCR_REDIS_URL=redis://redis:6379/0
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
OCR_API_KEY_PEPPER=CHANGE_ME_generate_a_48_byte_secret_before_first_run
OCR_ADMIN_TOKEN=CHANGE_ME_generate_a_different_48_byte_secret
OCR_METRICS_TOKEN=CHANGE_ME_metrics_bearer_token
OCR_STORAGE_BACKEND=s3
OCR_S3_ENDPOINT_URL=http://minio:9000
OCR_S3_BUCKET=bill-ocr
OCR_S3_ACCESS_KEY=minioadmin
OCR_S3_SECRET_KEY=minioadmin
OCR_S3_SSE=
OCR_OCR_PROVIDER=tesseract

# --- Hardening knobs (defaults are safe; see docs/ARCHITECTURE.md "Configuration") ---
# OCR_MAX_REQUEST_BYTES, OCR_QUEUE_MAX_DEPTH, OCR_BULK_QUEUE_MAX_DEPTH, OCR_WORKER_METRICS_PORT=9100
# Tracing is off by default. To enable: pip install -r requirements-otel.txt, then
# OCR_OTEL_ENABLED=true and standard OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME.
# OCR_ENV=prod refuses to start with placeholder secrets, dev S3 credentials or debug docs enabled.
