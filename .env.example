# Copy to .env (never commit .env). In production use a secret manager, not a file.
OCR_ENV=dev
OCR_DATABASE_URL=postgresql+psycopg://ocr:ocr@postgres:5432/ocr
OCR_REDIS_URL=redis://redis:6379/0
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
OCR_API_KEY_PEPPER=CHANGE_ME_generate_a_48_byte_secret_before_first_run
OCR_ADMIN_TOKEN=CHANGE_ME_generate_a_different_48_byte_secret
OCR_METRICS_TOKEN=CHANGE_ME_metrics_bearer_token
OCR_STORAGE_BACKEND=s3
OCR_S3_ENDPOINT_URL=http://minio:9000
OCR_S3_BUCKET=bill-ocr
OCR_S3_ACCESS_KEY=minioadmin
OCR_S3_SECRET_KEY=minioadmin
OCR_S3_SSE=
OCR_OCR_PROVIDER=tesseract

# --- Hardening knobs (defaults are safe; see docs/ARCHITECTURE.md "Configuration") ---
# OCR_MAX_REQUEST_BYTES, OCR_QUEUE_MAX_DEPTH, OCR_BULK_QUEUE_MAX_DEPTH, OCR_WORKER_METRICS_PORT=9100
# Tracing is off by default. To enable: pip install -r requirements-otel.txt, then
# OCR_OTEL_ENABLED=true and standard OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_SERVICE_NAME.
# OCR_ENV=prod refuses to start with placeholder secrets, dev S3 credentials or debug docs enabled.
# Second OCR pass for poor first results (empty = off): OCR_RETRY_PREPROCESS_OPS=upscale,adaptive  OCR_RETRY_TESSERACT_PSM=6
# Also: OCR_RETRY_BELOW_CONFIDENCE=0.5  OCR_RETRY_MAX_PAGES=3  OCR_TESSERACT_PSM=3 (first pass)

# Layout-aware extraction (OFF by default; see docs/LAYOUT_EXTRACTION.md). Controlled-trial settings:
#   OCR_REFERENCE_EXTRACTOR=layout-kv
#   OCR_EXTRACTOR_ALTERNATES=                      (empty = no alternate extractors; arbitration did not help on the synthetic round 2)
#   OCR_RETRY_PASSES=upscale@3;upscale,adaptive@6  (extra OCR variants, tried in order until key fields are clean)
#   OCR_VALIDATE_REQUIRED_FIELDS=true              (default: report missing/suspicious vendor, invoice number, date, total)
#   OCR_RETRY_ON_KEY_FIELDS=true                   (default: retry also when a key field is bad, even with high confidence)

# --- Invoice review web layer (compose profile "ui"; see docs/WEB_UI.md) ---
# Read by the webui service only, NOT by the API. The key is the collection client's API key (scopes bills:write, bills:read,
# feedback:write). It stays on the server: the browser never receives it.
# OCR_UI_API_KEY=
# OCR_UI_API_BASE_URL=http://api:8000
# OCR_UI_MAX_UPLOAD_BYTES=10485760
# OCR_UI_MAX_FILES_PER_UPLOAD=20
# OCR_UI_FEEDBACK_NOTICE=Your corrections may help improve invoice extraction accuracy.   # empty hides the notice
# OCR_UI_ALLOWED_ORIGINS=   # only if a reverse proxy rewrites Host; comma separated
